# ==============================================================================
# GOT U - PRODUCTION-GRADE SOCIAL PLATFORM ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env on your local development machine or production environment.
# Default configurations allow the app to run completely standalone out-of-the-box.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Relational Database & Connection Pooling
# ------------------------------------------------------------------------------
# Standard Connection URI format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://gotu_user:gotu_secret_password@localhost:5432/gotu_db
POSTGRES_DB=gotu_db
POSTGRES_USER=gotu_user
POSTGRES_PASSWORD=gotu_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection Pooling & Health Thresholds
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Redis 7 In-Memory Cache & Message Queue (BullMQ Coordinator)
# ------------------------------------------------------------------------------
# Redis connection URI format: redis://:PASSWORD@HOST:PORT/DB_INDEX
REDIS_URL=redis://:gotu_redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=gotu_redis_password

# ------------------------------------------------------------------------------
# 4. Background Workers & Transcoding Concurrency
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_STALLED_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 5. Object Storage Configuration (S3 / MinIO / Cloudflare R2 / GCS / Supabase)
# ------------------------------------------------------------------------------
# Provider options: 'local' | 's3' | 'minio' | 'supabase'
# Default: 'local' (writes to /uploads and /data)
STORAGE_PROVIDER=local

# Supabase Storage & Database Configuration (When using Supabase)
# Obtain from your Supabase Dashboard: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gotu-media

# S3 / MinIO Credentials & Endpoints (When using S3 / MinIO / R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gotu_minio_admin
S3_SECRET_KEY=gotu_minio_secret

# S3 Bucket Names
S3_BUCKET_NAME=gotu-processed-media
S3_RAW_BUCKET_NAME=gotu-raw-uploads
S3_PROCESSED_BUCKET_NAME=gotu-processed-media

# Path-style (true for MinIO/Local, false for standard AWS S3)
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 6. Global Content Delivery Network (CDN) & Edge Caching
# ------------------------------------------------------------------------------
# Public CDN URL prefix (e.g. https://cdn.gotu.app)
CDN_BASE_URL=
S3_PUBLIC_URL_PREFIX=
CDN_SIGNING_KEY=
CDN_SIGNING_KEY_ID=

# ------------------------------------------------------------------------------
# 7. Media Delivery, Caching & Security Policies
# ------------------------------------------------------------------------------
MEDIA_METADATA_CACHE_TTL_SECONDS=3600
MEDIA_VARIANTS_CACHE_TTL_SECONDS=3600
MEDIA_PLAYBACK_CACHE_TTL_SECONDS=1800
MEDIA_URL_TTL_SECONDS=900
STREAMING_BUFFER_CHUNK_BYTES=2097152
MEDIA_RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Upload Policies & Resumable Multipart Limits
# ------------------------------------------------------------------------------
MAX_IMAGE_SIZE_BYTES=52428800
MAX_VIDEO_SIZE_BYTES=5368709120
UPLOAD_PART_SIZE_BYTES=5242880
UPLOAD_SESSION_TTL_SECONDS=86400
MAX_CONCURRENT_UPLOADS_PER_USER=5

# ------------------------------------------------------------------------------
# 9. Firebase Authentication & Identity Bridge
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=gotu-app
ALLOW_AUTO_PROVISIONING=true
SOCIAL_DATA_SOURCE=postgres
ENABLE_SHADOW_VALIDATION=false

# ------------------------------------------------------------------------------
# 10. AI & Moderation Services (Optional)
# ------------------------------------------------------------------------------
# Server-only. Used for AI conversation assistant & automated feed moderation.
# If omitted, AI features return graceful fallback responses without crashing the app.
# Obtain from: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 11. Master Administrator Authentication (Optional)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
