{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate": "tsx server/db/migrate.ts",
    "worker": "tsx server/workers/runWorker.ts",
    "test:storage": "tsx scripts/test-storage.ts",
    "test:database": "tsx scripts/test-database.ts",
    "test:queue": "tsx scripts/test-queue.ts",
    "test:media": "tsx scripts/test-media.ts",
    "test:upload": "tsx scripts/test-upload.ts",
    "test:delivery": "tsx scripts/test-delivery-pipeline.ts",
    "test:social": "tsx scripts/test-social-feed.ts",
    "test:migration": "tsx scripts/test-migration.ts",
    "test:client": "tsx scripts/test-android-client.ts",
    "test:reliability": "tsx scripts/test-step10-reliability.ts",
    "test:readiness": "tsx scripts/test-step11-production-readiness.ts",
    "test:backup": "tsx scripts/operational-backup-verify.ts",
    "test:prod": "tsx scripts/test-step11-production-readiness.ts",
    "test:reel-perf": "tsx scripts/test-reel-playback-performance.ts",
    "migrate:firebase": "tsx scripts/migrate-firebase-social-data.ts",
    "reconcile:storage": "tsx scripts/reconcile-media-storage.ts",
    "test:all": "npm run test:storage && npm run test:database && npm run test:queue && npm run test:media && npm run test:upload && npm run test:delivery && npm run test:social && npm run test:migration && npm run test:client && npm run test:reliability && npm run test:readiness"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "^6.3.2",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "hls.js": "^1.7.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
